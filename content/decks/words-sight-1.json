    { "id": "words.sight-1.will", "text": "will", "parts": ["w", "i", "ll"], "note": "all regular; ll is one l" },
    { "id": "words.sight-1.just", "text": "just", "parts": ["j", "u", "s", "t"], "note": "all regular: j-u-s-t" },
