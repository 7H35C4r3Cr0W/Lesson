    { "id": "words.sight-1.black", "text": "black", "parts": ["b", "l", "a", "ck"], "emoji": "⚫", "note": "all regular; ck is one sound" },
    { "id": "words.sight-1.after", "text": "after", "parts": ["a", "f", "t", "er"], "note": "all regular; two parts: af + ter, er says er" },
    { "id": "words.sight-1.came", "text": "came", "parts": ["c", "a", "m", "e"], "note": "magic e: the a says its name" },
