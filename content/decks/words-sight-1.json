    { "id": "words.sight-1.too", "text": "too", "parts": ["t", "oo"], "note": "oo as in moon; too means also, or more than enough" },
    { "id": "words.sight-1.or", "text": "or", "parts": ["or"], "note": "or says or, like in for and fork" },
