# Star Cards on a Raspberry Pi. Installed by deploy/install.sh.
#
# Code:     /opt/starcards        (root-owned, read-only to the service)
# Database: /var/lib/starcards    (the only place the service can write; backups live in backups/)
# Settings: /etc/default/starcards  (optional: STARCARDS_LLM_URL etc. for the Help button)
# Logs:     journalctl -u starcards -f

[Unit]
Description=Star Cards first-grade flashcards
After=network-online.target
Wants=network-online.target

[Service]
User=starcards
Group=starcards
WorkingDirectory=/opt/starcards
EnvironmentFile=-/etc/default/starcards
# Port 80 so the tablet can open http://starcards.local/ with no port number.
ExecStart=/usr/bin/python3 -u /opt/starcards/server.py --port 80 --data-dir /var/lib/starcards $STARCARDS_ARGS
StateDirectory=starcards
Restart=on-failure
RestartSec=3

# Binding port 80 without root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandbox. The service can read /opt/starcards and write /var/lib/starcards, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=300M
TasksMax=64

[Install]
WantedBy=multi-user.target
