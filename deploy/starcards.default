# /etc/default/starcards  --  optional settings for the Star Cards service.
# After editing:  sudo systemctl restart starcards

# The 🙋 Help button: point at a local OpenAI-compatible model server (Ollama, LM Studio, llama.cpp).
# The Pi must be able to reach this address. Leave blank to turn the button off.
#STARCARDS_LLM_URL=http://192.168.1.20:11434/v1
#STARCARDS_LLM_MODEL=llama3.1:8b
#STARCARDS_LLM_KEY=

# Extra flags for server.py, for example:
#   --allow-host cards.home     (another name the tablet uses for the Pi)
#   --cert /etc/starcards/cert.pem --key /etc/starcards/key.pem --port 443   (https; see README)
#   --content-dir /var/lib/starcards/content   (edit decks on the Pi instead of redeploying)
STARCARDS_ARGS=
